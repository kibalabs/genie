{{ autogenerated_notice }}
{% if target.requires_date_parsing(renderableTypes=target.resource_field_types(api=api)) %}
import { dateFromString, dateToString, RawObject } from '@kibalabs/core';
{% else %}
import { RawObject } from '@kibalabs/core';
{% endif %}

export type JsonValue = string | number | boolean | null | JsonValue[] | { [key: string]: JsonValue };
{% for enum in api.enums %}

export type {{ target.enum_class_name(enum=enum, apiVersion=api.version) }} = {{ target.enum_union(values=enum.values) }};
{% endfor %}
{% for resource in api.resources %}
{% set className = target.resource_class_name(resource=resource, apiVersion=api.version) %}

export class {{ className }} {
{% if resource.attributes %}
  public constructor(
{% for attribute in resource.attributes %}
    readonly {{ target.identifier(name=attribute.name) }}: {{ target.type(renderableType=attribute.fieldType, apiVersion=api.version, isLocalReference=True) }},
{% endfor %}
  ) { }

  public static fromObject = (obj: RawObject): {{ className }} => {
    return new {{ className }}(
{% for attribute in resource.attributes %}
      {{ target.from_object(renderableType=attribute.fieldType, value='obj.' ~ target.identifier(name=attribute.name), apiVersion=api.version, isLocalReference=True) }},
{% endfor %}
    );
  };

  public toObject = (): RawObject => {
    return {
{% for attribute in resource.attributes %}
      {{ target.identifier(name=attribute.name) }}: {{ target.to_object(renderableType=attribute.fieldType, value='this.' ~ target.identifier(name=attribute.name), apiVersion=api.version, isLocalReference=True) }},
{% endfor %}
    };
  };
{% else %}
  public static fromObject = (): {{ className }} => {
    return new {{ className }}();
  };

  public toObject = (): RawObject => {
    return {};
  };
{% endif %}
}
{% endfor %}
{% for oneOf in api.oneOfs %}
{% set typeName = target.one_of_class_name(oneOf=oneOf, apiVersion=api.version) %}
{% set discriminator = target.identifier(name=oneOf.discriminator) %}

export type {{ typeName }} = {{ target.one_of_member_class_names(oneOf=oneOf, apiVersion=api.version) | join(' | ') }};

export const {{ target.one_of_parser_name(name=oneOf.name, apiVersion=api.version) }} = (obj: RawObject): {{ typeName }} => {
  switch (obj.{{ discriminator }}) {
{% for member in oneOf.members %}
    case '{{ member.value }}':
      return {{ target.one_of_member_class_names(oneOf=oneOf, apiVersion=api.version)[loop.index0] }}.fromObject(obj);
{% endfor %}
    default:
      throw new Error(`Unknown {{ typeName }} {{ discriminator }}: ${String(obj.{{ discriminator }})}`);
  }
};
{% endfor %}
